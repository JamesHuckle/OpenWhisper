# Used by a development run when no API key is saved in the app's settings.
OPENAI_API_KEY=your_openai_api_key_here
OPENWHISPER_MODEL=gpt-transcribe
# Optional: the model for "Refine with AI" (a GPT-5 model; default gpt-5-nano, named in the desktop settings).
# OPENWHISPER_POLISH_MODEL=gpt-5-nano
# Optional: reasoning effort for that model (default minimal; low is used if the model rejects it).
# OPENWHISPER_POLISH_REASONING=minimal

# Tauri updater signing key for local signed builds. Releases are built by
# GitHub Actions with the same key saved as a repository secret (see README).
# Create it once with: .\scripts\setup-updater-keys.ps1
TAURI_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Android release signing (created by .\scripts\setup-android-signing.ps1).
# Keep real values only in .env and back up the keystore separately.
OPENWHISPER_ANDROID_KEYSTORE=
OPENWHISPER_ANDROID_KEY_ALIAS=
OPENWHISPER_ANDROID_STORE_PASSWORD=
OPENWHISPER_ANDROID_KEY_PASSWORD=
